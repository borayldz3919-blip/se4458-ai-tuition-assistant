# Copy to .env and fill in. Never commit .env.
JWT_SECRET=change-me-to-a-long-random-hex-string-0123456789abcdef
# Free key: https://aistudio.google.com/apikey
LLM_API_KEY=
# Comma-separated: if the first model is overloaded (HTTP 503/429) the next one is used
LLM_MODEL=gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
