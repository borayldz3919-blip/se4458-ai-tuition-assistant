{
  "openapi": "3.1.0",
  "info": {
    "title": "Tuition API",
    "description": "\nTuition REST API used by the University Mobile App, the Banking App, the University admin web site\nand the AI Tuition Assistant.\n\n* All routes are **versioned** (`/api/v1/...`) and are exposed to clients only through the **API Gateway**.\n* Protected routes need `Authorization: Bearer <JWT>` from `POST /api/v1/auth/login`.\n* Errors always look like `{\"error\": {\"code\": \"...\", \"message\": \"...\"}}`.\n",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Get a JWT (students log in with their student number)",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Error: {\"error\": {\"code\", \"message\"}}"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/mobile/tuition/{student_no}": {
      "get": {
        "tags": [
          "University Mobile App"
        ],
        "summary": "Query Tuition (no auth, max 3 calls per student per day)",
        "operationId": "mobile_query_tuition_api_v1_mobile_tuition__student_no__get",
        "parameters": [
          {
            "name": "student_no",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{6,12}$",
              "examples": [
                "20230001"
              ],
              "title": "Student No"
            }
          },
          {
            "name": "term",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-(FALL|SPRING|SUMMER)$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional. Omit for the OVERALL balance across all terms.",
              "title": "Term"
            },
            "description": "Optional. Omit for the OVERALL balance across all terms."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TuitionQueryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Error: {\"error\": {\"code\", \"message\"}}"
          },
          "429": {
            "description": "Error: {\"error\": {\"code\", \"message\"}}"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/banking/tuition/{student_no}": {
      "get": {
        "tags": [
          "Banking App"
