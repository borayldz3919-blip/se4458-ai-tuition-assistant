        "summary": "Query Tuition (auth required)",
        "operationId": "banking_query_tuition_api_v1_banking_tuition__student_no__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "student_no",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{6,12}$",
              "examples": [
                "20230001"
              ],
              "title": "Student No"
            }
          },
          {
            "name": "term",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-(FALL|SPRING|SUMMER)$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional. Omit for the OVERALL balance across all terms.",
              "title": "Term"
            },
            "description": "Optional. Omit for the OVERALL balance across all terms."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TuitionQueryResponse"
                }
              }
            }
          },
          "401": {
            "description": "Error: {\"error\": {\"code\", \"message\"}}"
          },
          "403": {
            "description": "Error: {\"error\": {\"code\", \"message\"}}"
          },
          "404": {
            "description": "Error: {\"error\": {\"code\", \"message\"}}"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/banking/payments": {
      "post": {
        "tags": [
          "Banking App"
        ],
        "summary": "Pay Tuition (simulated partial or full payment)",
        "operationId": "pay_tuition_api_v1_banking_payments_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "401": {
            "description": "Error: {\"error\": {\"code\", \"message\"}}"
          },
          "403": {
            "description": "Error: {\"error\": {\"code\", \"message\"}}"
          },
          "404": {
            "description": "Error: {\"error\": {\"code\", \"message\"}}"
          },
          "409": {
            "description": "Error: {\"error\": {\"code\", \"message\"}}"
          },
          "422": {
            "description": "Error: {\"error\": {\"code\", \"message\"}}"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/admin/tuition": {
      "post": {
        "tags": [
          "University Web Site - Admin"
        ],
        "summary": "Add Tuition (create, or update if the student/term already exists)",
        "operationId": "add_tuition_api_v1_admin_tuition_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddTuitionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddTuitionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Error: {\"error\": {\"code\", \"message\"}}"
          },
          "403": {
            "description": "Error: {\"error\": {\"code\", \"message\"}}"
          },
          "409": {
            "description": "Error: {\"error\": {\"code\", \"message\"}}"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/admin/tuition/batch": {
      "post": {
        "tags": [
          "University Web Site - Admin"
        ],
        "summary": "Add Tuition - Batch (CSV: studentNo,term,amount,currency)",
        "operationId": "add_tuition_batch_api_v1_admin_tuition_batch_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_add_tuition_batch_api_v1_admin_tuition_batch_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Error: {\"error\": {\"code\", \"message\"}}"
          },
          "401": {
            "description": "Error: {\"error\": {\"code\", \"message\"}}"
          },
          "403": {
            "description": "Error: {\"error\": {\"code\", \"message\"}}"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/admin/tuition/unpaid": {
      "get": {
        "tags": [
          "University Web Site - Admin"
        ],
        "summary": "Unpaid Tuition Status (paged)",
        "operationId": "unpaid_api_v1_admin_tuition_unpaid_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "term",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-(FALL|SPRING|SUMMER)$",
              "examples": [
                "2026-FALL"
              ],
              "title": "Term"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 10,
              "title": "Pagesize"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnpaidPage"
                }
              }
            }
          },
          "401": {
            "description": "Error: {\"error\": {\"code\", \"message\"}}"
          },
          "403": {
            "description": "Error: {\"error\": {\"code\", \"message\"}}"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Ops"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddTuitionRequest": {
        "properties": {
          "studentNo": {
            "type": "string",
            "pattern": "^\\d{6,12}$",
            "title": "Studentno",
            "examples": [
              "20230001"
            ]
          },
          "term": {
            "type": "string",
            "pattern": "^\\d{4}-(FALL|SPRING|SUMMER)$",
            "title": "Term",
            "examples": [
              "2026-FALL"
            ]
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,10}|(?=[\\d.]{1,13}0*$)\\d{0,10}\\.\\d{0,2}0*$)"
              }
            ],
            "title": "Amount",
            "examples": [
              3000
            ]
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "EUR",
              "TRY"
            ],
            "title": "Currency",
            "examples": [
              "USD"
            ]
          }
        },
        "type": "object",
        "required": [
          "studentNo",
          "term",
          "amount",
          "currency"
        ],
        "title": "AddTuitionRequest"
      },
      "AddTuitionResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "CREATED",
              "UPDATED"
            ],
            "title": "Status"
          },
          "studentNo": {
            "type": "string",
            "title": "Studentno"
          },
          "term": {
            "type": "string",
            "title": "Term"
          },
          "tuitionTotal": {
            "type": "number",
            "title": "Tuitiontotal"
          },
          "balance": {
            "type": "number",
            "title": "Balance"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          }
        },
        "type": "object",
        "required": [
          "status",
          "studentNo",
          "term",
          "tuitionTotal",
          "balance",
          "currency"
        ],
        "title": "AddTuitionResponse"
      },
      "BatchResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "COMPLETED",
              "COMPLETED_WITH_ERRORS",
              "FAILED"
            ],
            "title": "Status"
          },
          "totalRows": {
            "type": "integer",
            "title": "Totalrows"
          },
          "successCount": {
            "type": "integer",
            "title": "Successcount"
          },
          "failureCount": {
            "type": "integer",
            "title": "Failurecount"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/BatchRowResult"
            },
            "type": "array",
            "title": "Results"
          }
        },
        "type": "object",
        "required": [
          "status",
          "totalRows",
          "successCount",
          "failureCount",
          "results"
        ],
        "title": "BatchResponse"
      },
      "BatchRowResult": {
        "properties": {
          "line": {
            "type": "integer",
            "title": "Line"
          },
          "studentNo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Studentno"
          },
          "term": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Term"
          },
          "status": {
            "type": "string",
            "enum": [
              "CREATED",
              "UPDATED",
              "FAILED"
            ],
            "title": "Status"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "line",
          "studentNo",
          "term",
          "status"
        ],
        "title": "BatchRowResult"
      },
      "Body_add_tuition_batch_api_v1_admin_tuition_batch_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_add_tuition_batch_api_v1_admin_tuition_batch_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username",
            "examples": [
              "20230001"
            ]
          },
          "password": {
            "type": "string",
            "title": "Password",
            "examples": [
              "Student123!"
            ]
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest"
      },
      "PaymentRequest": {
        "properties": {
          "studentNo": {
            "type": "string",
            "pattern": "^\\d{6,12}$",
            "title": "Studentno",
            "examples": [
              "20230001"
            ]
          },
          "term": {
            "type": "string",
            "pattern": "^\\d{4}-(FALL|SPRING|SUMMER)$",
            "title": "Term",
            "examples": [
              "2026-FALL"
            ]
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,10}|(?=[\\d.]{1,13}0*$)\\d{0,10}\\.\\d{0,2}0*$)"
              }
            ],
            "title": "Amount",
            "examples": [
              1000
            ]
          },
          "transactionId": {
            "type": "string",
            "maxLength": 64,
            "minLength": 4,
            "title": "Transactionid",
            "examples": [
              "TX-20261121-0001"
            ]
          }
        },
        "type": "object",
        "required": [
          "studentNo",
          "term",
          "amount",
          "transactionId"
        ],
        "title": "PaymentRequest"
      },
      "PaymentResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "SUCCESS",
            "title": "Status"
          },
          "transactionId": {
            "type": "string",
            "title": "Transactionid"
          },
          "studentNo": {
            "type": "string",
            "title": "Studentno"
          },
          "term": {
            "type": "string",
            "title": "Term"
          },
          "paidAmount": {
            "type": "number",
            "title": "Paidamount"
          },
          "remainingBalance": {
            "type": "number",
            "title": "Remainingbalance"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          }
        },
        "type": "object",
        "required": [
          "status",
          "transactionId",
          "studentNo",
          "term",
          "paidAmount",
          "remainingBalance",
          "currency"
        ],
        "title": "PaymentResponse"
      },
      "TermTuition": {
        "properties": {
          "term": {
            "type": "string",
            "title": "Term"
          },
          "tuitionTotal": {
            "type": "number",
            "title": "Tuitiontotal"
          },
          "paidAmount": {
            "type": "number",
            "title": "Paidamount"
          },
          "balance": {
            "type": "number",
            "title": "Balance"
          },
          "status": {
            "type": "string",
            "enum": [
              "PAID",
              "PARTIALLY_PAID",
              "UNPAID"
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "term",
          "tuitionTotal",
          "paidAmount",
          "balance",
          "status"
        ],
        "title": "TermTuition"
      },
      "TokenResponse": {
        "properties": {
          "accessToken": {
            "type": "string",
            "title": "Accesstoken"
          },
          "tokenType": {
            "type": "string",
            "title": "Tokentype",
            "default": "Bearer"
          },
          "expiresIn": {
            "type": "integer",
            "title": "Expiresin"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "studentNo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Studentno"
          }
        },
        "type": "object",
        "required": [
          "accessToken",
          "expiresIn",
          "role"
        ],
        "title": "TokenResponse"
      },
      "TuitionQueryResponse": {
        "properties": {
          "studentNo": {
            "type": "string",
            "title": "Studentno"
          },
          "fullName": {
            "type": "string",
            "title": "Fullname"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "tuitionTotal": {
            "type": "number",
            "title": "Tuitiontotal"
          },
          "balance": {
            "type": "number",
            "title": "Balance"
          },
          "scope": {
            "type": "string",
            "enum": [
              "OVERALL",
              "TERM"
            ],
            "title": "Scope"
          },
          "terms": {
            "items": {
              "$ref": "#/components/schemas/TermTuition"
            },
            "type": "array",
            "title": "Terms"
          }
        },
        "type": "object",
        "required": [
          "studentNo",
          "fullName",
          "currency",
          "tuitionTotal",
          "balance",
          "scope",
          "terms"
        ],
        "title": "TuitionQueryResponse",
        "description": "`tuitionTotal` and `balance` are OVERALL figures across all terms (or for `term` if the\n`term` query parameter is given). `terms` always contains the per-term breakdown."
      },
      "UnpaidItem": {
        "properties": {
          "studentNo": {
            "type": "string",
            "title": "Studentno"
          },
          "fullName": {
            "type": "string",
            "title": "Fullname"
          },
          "tuitionTotal": {
            "type": "number",
            "title": "Tuitiontotal"
          },
          "paidAmount": {
            "type": "number",
            "title": "Paidamount"
          },
          "balance": {
            "type": "number",
            "title": "Balance"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          }
        },
        "type": "object",
        "required": [
          "studentNo",
          "fullName",
          "tuitionTotal",
          "paidAmount",
          "balance",
          "currency"
        ],
        "title": "UnpaidItem"
      },
      "UnpaidPage": {
        "properties": {
          "term": {
            "type": "string",
            "title": "Term"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "pageSize": {
            "type": "integer",
            "title": "Pagesize"
          },
          "totalItems": {
            "type": "integer",
            "title": "Totalitems"
          },
          "totalPages": {
            "type": "integer",
            "title": "Totalpages"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/UnpaidItem"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "term",
          "page",
          "pageSize",
          "totalItems",
          "totalPages",
          "items"
        ],
        "title": "UnpaidPage"
      },
      "ValidationError": {
        "properties": {
